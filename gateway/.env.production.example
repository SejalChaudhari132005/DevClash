# ==============================================================================
# DEVCLASH SPRING BOOT GATEWAY - PRODUCTION ENVIRONMENT
# ==============================================================================

# Internal HTTP Port for Gateway (listens on private network; Nginx reverse proxies public traffic)
SERVER_PORT=8085

# RMI Server connection details (must point to RMI Server private IP)
RMI_SERVER_HOST=10.0.1.30
RMI_SERVER_PORT=1099
RMI_SERVICE_NAME=DevClashQuizService

# RMI Callback listener export details (RMI Server calls back to Gateway)
RMI_CALLBACK_PORT=1097
RMI_CALLBACK_HOST=10.0.1.10

# Allowed CORS and WebSocket origins (comma-separated list of approved web origins)
CORS_ALLOWED_ORIGINS=https://devclash.yourdomain.com,https://www.yourdomain.com

# Reverse Proxy / SSL header forwarding
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Logging
LOGGING_LEVEL_COM_DEVCLASH_GATEWAY=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB_SOCKET=WARN
