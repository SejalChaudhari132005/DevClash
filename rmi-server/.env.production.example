# Private IP / Hostname of this RMI Server machine (e.g. within AWS VPC / private network)
# java.rmi.server.hostname will be set to this value to ensure Gateway receives a reachable stub.
RMI_HOST=10.0.1.30

# Port for the RMI Registry (default 1099)
RMI_PORT=1099

# Explicit port for exported remote objects (UnicastRemoteObject).
# Setting a fixed port (e.g. 1098) allows strict firewall rule enforcement.
RMI_OBJECT_PORT=1098

# Service binding name in RMI Registry
RMI_SERVICE_NAME=DevClashQuizService

# MySQL Database credentials
DB_HOST=10.0.1.20
DB_PORT=3306
DB_NAME=devclash_db
DB_USER=devclash_prod_user
DB_PASSWORD=ReplaceWithStrongProdPassword_9#kL!29x
DB_POOL_SIZE=20
DB_MIN_IDLE=5
