# ==============================================================================
# DEVCLASH FRONTEND (Vite / React) - PRODUCTION BUILD CONFIGURATION
# ==============================================================================
# When deploying behind an Nginx reverse proxy on the same domain, leave empty
# as GameContext automatically resolves https://<current-host> and wss://<current-host>/ws-devclash.
#
# If deploying frontend to a standalone CDN / Vercel / Cloudflare Pages, specify the Gateway's public domain:
VITE_GATEWAY_URL=https://api.devclash.yourdomain.com
VITE_GATEWAY_WS_URL=https://api.devclash.yourdomain.com/ws-devclash
