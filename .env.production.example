# ==============================================================================
# DEVCLASH - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env on your production server and populate secure credentials.
# NEVER commit production .env with real passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PERSISTENCE TIER (MySQL Database)
# ------------------------------------------------------------------------------
# In production, use a managed database (e.g., AWS RDS, DigitalOcean Managed MySQL,
# PlanetScale, Aiven) or a secured local MySQL container.
DB_HOST=10.0.1.20
DB_PORT=3306
DB_NAME=devclash_db
DB_USER=devclash_prod_user
DB_PASSWORD=ReplaceWithStrongProdPassword_9#kL!29x
DB_POOL_SIZE=20
DB_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 2. DISTRIBUTED COMPUTING TIER (Java RMI Quiz Server)
# ------------------------------------------------------------------------------
# RMI_HOST: Private IP / VPC hostname of the RMI Server machine (e.g. 10.0.1.30).
# CRITICAL: This is advertised in the RMI stub (java.rmi.server.hostname).
# MUST be reachable by the Gateway over the private network.
RMI_HOST=10.0.1.30
RMI_PORT=1099
RMI_OBJECT_PORT=1098
RMI_SERVICE_NAME=DevClashQuizService

# ------------------------------------------------------------------------------
# 3. GATEWAY TIER (Spring Boot Gateway)
# ------------------------------------------------------------------------------
SERVER_PORT=8085
RMI_SERVER_HOST=10.0.1.30
RMI_SERVER_PORT=1099

# RMI Callback Listener (RMI Server -> Gateway notification channel)
# If Gateway and RMI Server run on separate machines, RMI_CALLBACK_HOST must be Gateway's private IP
RMI_CALLBACK_PORT=1097
RMI_CALLBACK_HOST=10.0.1.10

# Production CORS & WebSocket Origin Restriction
# Comma-separated list of allowed client origins.
# Use your actual public production domains (e.g. https://devclash.yourdomain.com).
CORS_ALLOWED_ORIGINS=https://devclash.yourdomain.com,https://www.yourdomain.com

# Gateway Reverse Proxy / SSL Settings (Nginx handles public SSL termination)
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Optional native Spring Boot SSL (if terminating SSL inside Spring Boot instead of Nginx)
SSL_ENABLED=false
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=PKCS12

# ------------------------------------------------------------------------------
# 4. FRONTEND TIER (Vite Production Build)
# ------------------------------------------------------------------------------
# In production with an Nginx reverse proxy, leave empty or set to your public domain.
# Nginx proxies /api and /ws-devclash on port 443 automatically.
VITE_GATEWAY_URL=https://devclash.yourdomain.com
VITE_GATEWAY_WS_URL=https://devclash.yourdomain.com/ws-devclash
